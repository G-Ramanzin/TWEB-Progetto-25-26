{{!-- Statistics dashboard: overview cards + four Chart.js charts fed via data-* attributes --}}
<h1 class="h3 mb-4"><i class="bi bi-bar-chart"></i> Statistiche</h1>

{{#if overview}}
<section class="row text-center g-3 mb-4">
    <div class="col-6 col-md-3"><div class="card stat-card p-3"><div class="fs-4 fw-bold">{{formatNumber overview.totalUsers}}</div><div class="text-muted">Utenti</div></div></div>
    <div class="col-6 col-md-3"><div class="card stat-card p-3"><div class="fs-4 fw-bold">{{formatNumber overview.totalRatings}}</div><div class="text-muted">Valutazioni</div></div></div>
    <div class="col-6 col-md-3"><div class="card stat-card p-3"><div class="fs-4 fw-bold">{{formatNumber overview.totalFavorites}}</div><div class="text-muted">Preferiti</div></div></div>
    <div class="col-6 col-md-3"><div class="card stat-card p-3"><div class="fs-4 fw-bold">{{overview.averageScore}}</div><div class="text-muted">Voto medio</div></div></div>
</section>
{{/if}}

<div class="row g-4">
    {{#if genreStats.length}}
    <div class="col-lg-6">
        <div class="card p-3">
            <h2 class="h6">Anime per genere (top 15)</h2>
            <div class="chart-wrap"><canvas
                data-chart="horizontalBar"
                data-labels='{{json (pluck genreStats "genre")}}'
                data-values='{{json (pluck genreStats "count")}}'
                data-label="Anime"></canvas></div>
        </div>
    </div>
    {{/if}}

    {{#if typeStats.length}}
    <div class="col-lg-6">
        <div class="card p-3">
            <h2 class="h6">Anime per formato</h2>
            <div class="chart-wrap"><canvas
                data-chart="doughnut"
                data-labels='{{json (pluck typeStats "type")}}'
                data-values='{{json (pluck typeStats "count")}}'
                data-label="Anime"></canvas></div>
        </div>
    </div>
    {{/if}}

    {{#if ratingDistribution.length}}
    <div class="col-lg-6">
        <div class="card p-3">
            <h2 class="h6">Distribuzione globale dei voti ({{formatNumber overview.totalRatings}} valutazioni)</h2>
            <div class="chart-wrap"><canvas
                data-chart="bar"
                data-labels='{{json (pluck ratingDistribution "rating")}}'
                data-values='{{json (pluck ratingDistribution "count")}}'
                data-label="Voti"></canvas></div>
        </div>
    </div>
    {{/if}}

    {{#if topAnime.length}}
    <div class="col-lg-6">
        <div class="card p-3">
            <h2 class="h6">Top 10 per voto MAL</h2>
            <ol class="list-group list-group-numbered list-group-flush">
                {{#each topAnime}}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a href="/anime/{{this.animeId}}" class="text-decoration-none">{{truncate this.title 50}}</a>
                    <span class="badge bg-warning text-dark">{{this.score}}</span>
                </li>
                {{/each}}
            </ol>
        </div>
    </div>
    {{/if}}
</div>
