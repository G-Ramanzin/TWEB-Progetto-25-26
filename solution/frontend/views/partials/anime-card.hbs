<div class="col">
    <div class="card h-100 anime-card">
        {{#if imageUrl}}
        <img src="{{imageUrl}}" class="card-img-top anime-card-img" alt="{{title}}" loading="lazy"
             onerror="this.style.display='none'">
        {{/if}}
        <div class="card-body d-flex flex-column">
            <h6 class="card-title mb-1">
                <a href="/anime/{{animeId}}" class="stretched-link text-decoration-none">{{truncate title 60}}</a>
            </h6>
            <div class="mt-auto small text-muted">
                {{#if type}}<span class="badge bg-secondary me-1">{{type}}</span>{{/if}}
                {{#if score}}<span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> {{score}}</span>{{/if}}
            </div>
        </div>
    </div>
</div>
