{{!-- Character detail: identity, nicknames, anime appearances with real titles --}}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/characters">Personaggi</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{character.name}}</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-md-3">
        {{#if character.imageUrl}}
        <img src="{{character.imageUrl}}" class="img-fluid rounded shadow" alt="{{character.name}}"
             onerror="this.style.display='none'">
        {{/if}}
    </div>
    <div class="col-md-9">
        <h1 class="h2">{{character.name}}</h1>
        {{#if character.nameKanji}}<p class="text-muted">{{character.nameKanji}}</p>{{/if}}
        {{#if character.favorites}}
        <p><span class="badge bg-danger fs-6"><i class="bi bi-heart-fill"></i> {{formatNumber character.favorites}} preferiti</span></p>
        {{/if}}

        {{#if nicknames.length}}
        <p>
            <span class="text-muted small">Soprannomi:</span>
            {{#each nicknames}}<span class="badge bg-secondary me-1">{{this}}</span>{{/each}}
        </p>
        {{/if}}

        {{#if character.about}}
        <h2 class="h5 mt-4">Descrizione</h2>
        <p class="synopsis" style="white-space: pre-line">{{truncate character.about 2000}}</p>
        {{/if}}
    </div>
</div>

{{#if appearances.length}}
<section class="mt-5">
    <h2 class="h4 mb-3"><i class="bi bi-collection-play"></i> Appare in</h2>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Anime</th><th>Ruolo</th><th>Voto</th></tr></thead>
            <tbody>
                {{#each appearances}}
                <tr>
                    <td><a href="/anime/{{this.animeId}}" class="text-decoration-none">{{this.title}}</a></td>
                    <td>{{this.role}}</td>
                    <td>{{#if this.score}}<span class="badge bg-warning text-dark">{{this.score}}</span>{{/if}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
{{/if}}
